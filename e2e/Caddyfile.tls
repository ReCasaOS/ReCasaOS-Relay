# TLS terminator for the e2e network only: relay.test with a certificate from Caddy's internal CA.
{
	local_certs
	skip_install_trust

	# share sends the visitor's address as a PROXY v2 header; before tls, since it precedes the handshake.
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				allow 172.29.0.0/24
			}
			tls
		}
	}
	servers :80 {
		listener_wrappers {
			proxy_protocol {
				allow 172.29.0.0/24
			}
		}
	}
}

# Access log for the journal (/admin/journal): JSON lines in the `front-logs` volume, which enrolment reads.
# Headers are never written (Authorization, cookies, X-Box-Signature); rolls stay uncompressed so they are read.
(journal) {
	log {
		output file /logs/front.log {
			roll_size 64MiB
			roll_keep 8
			roll_keep_for {$LOG_KEEP:168h}
			roll_uncompressed
			mode 0644
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
			}
		}
	}
}

# An explicit http:// site: the wrapper of `servers :80` only reaches a server defined by a site like this
# one, not the redirect server Caddy adds by itself for relay.test (same site as section 14 of the docs).
http://*.box.relay.test {
	import journal
	redir https://{host}{uri} 301
}

relay.test {
	import journal
	tls internal

	# In production one Caddy terminates TLS and routes to enrolment itself. Here tlsfront stands in for it,
	# so the login form goes straight to enrolment with the visitor's address (front, behind us, would see
	# tlsfront as the peer).
	@login path /register/*
	handle @login {
		reverse_proxy enrolment:8081 {
			header_up X-Client-IP {client_ip}
		}
	}

	# Box tunnels, likewise: share rate-limits them per client IP.
	@tunnel path /v1/share/tunnel
	handle @tunnel {
		reverse_proxy share:8082 {
			header_up X-Client-IP {client_ip}
		}
	}

	handle {
		reverse_proxy front:8080
	}
}

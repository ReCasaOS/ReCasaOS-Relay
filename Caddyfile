# Public front. Headscale's admin REST API (/api/) shares its port with the box control plane and must
# only be reachable by `enrolment`, so it is answered 404 here. /v1/* goes to the enrolment service,
# which is NOT published: this proxy is its only way in, so the client address it receives is one we set.
# /derp goes to the derper service; /debug (derper's debug pages) is answered 404.
# (enrolment's own /healthz stays internal.)
{
	auto_https off
}

:8080 {
	# derper's debug pages (node keys, client addresses) are for `enrolment` only, on the compose network.
	@debug path /debug /debug/*
	handle @debug {
		respond 404
	}

	# /internal/* (the enrolment service's share routes) is deliberately not routed either: it falls through
	# to Headscale and answers 404, like /api. Only services on the compose network reach it.
	@api path /api /api/*
	handle @api {
		respond 404
	}

	# /admin is the operator page: the service answers 404 unless ADMIN_TOKEN is set.
	@enrolment path /v1/* /admin /admin/*
	handle @enrolment {
		reverse_proxy enrolment:8081 {
			# header_up replaces any value sent by the client; {client_ip} is the TCP peer, or the real
			# client when `trusted_proxies` lists the proxy in front of this one (see README).
			header_up X-Client-IP {client_ip}
		}
	}

	# Headscale's web-login page (<server_url>/register/<auth id>) is answered by the enrolment service.
	@login path /register/*
	handle @login {
		reverse_proxy enrolment:8081 {
			header_up X-Client-IP {client_ip}
		}
	}

	# The DERP relay (standalone derper, plain HTTP); the connection upgrade passes through.
	@derp path /derp /derp/* /generate_204
	handle @derp {
		reverse_proxy derper:8090
	}

	handle {
		reverse_proxy headscale:8080
	}
}

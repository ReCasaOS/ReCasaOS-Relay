# Public front for Headscale: forwards everything except the admin REST API (/api/), which Headscale
# serves on the same port as the box control plane and which must only be reachable by `enrolment`.
{
	auto_https off
}

:8080 {
	@api path /api /api/*
	respond @api 404
	reverse_proxy headscale:8080
}
